<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="vertical">

    <include
        android:id="@+id/includeHeader"
        layout="@layout/include_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- ═══ COMPOSE SECTION ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_surface"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_send_notification"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <!-- Target Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/tabAll"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/label_all_users"
                android:textColor="@color/accent_gold"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_card_accent"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView android:id="@+id/tabSingle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/label_single_user"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:background="@drawable/bg_card_accent"
                android:layout_marginHorizontal="4dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView android:id="@+id/tabPremium"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/filter_premium"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:background="@drawable/bg_card_accent"
                android:layout_marginStart="4dp"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- User ID input (hidden by default) -->
        <EditText
            android:id="@+id/etUserId"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_user_id"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:visibility="gone"
            android:inputType="text"
            android:importantForAutofill="no"
            tools:targetApi="o"/>

        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_notif_title"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:inputType="textCapSentences"
            android:importantForAutofill="no"
            tools:targetApi="o"/>

        <EditText
            android:id="@+id/etImageUrl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Image URL (Optional)"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:inputType="textUri"
            android:importantForAutofill="no"
            tools:ignore="HardcodedText"/>

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_notif_message"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:padding="14dp"
            android:gravity="top"
            android:inputType="textMultiLine|textCapSentences"
            android:importantForAutofill="no"
            tools:targetApi="o"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="@string/btn_send_notif"
            android:textColor="@color/bg_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/accent_gold"
            app:cornerRadius="12dp"/>
    </LinearLayout>

    <!-- ═══ HISTORY ═══ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/header_sent_history"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"/>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/msg_no_history"
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:padding="20dp"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNotifications"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false"/>
</LinearLayout>
