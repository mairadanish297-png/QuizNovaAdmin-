<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="vertical">

    <include
        android:id="@+id/includeHeader"
        layout="@layout/include_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_generator_title"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/powered_by_groq"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginTop="4dp"/>

            <!-- CATEGORY -->
            <LinearLayout
                android:id="@+id/rowCategory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_accent"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_category"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"/>
                <TextView
                    android:id="@+id/tvCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/default_category"
                    android:textColor="@color/accent_gold"
                    android:textSize="15sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/symbol_arrow"
                    android:textColor="@color/text_muted"
                    android:textSize="18sp"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <!-- DIFFICULTY -->
            <LinearLayout
                android:id="@+id/rowDifficulty"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_accent"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_difficulty"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"/>
                <TextView
                    android:id="@+id/tvDifficulty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/default_difficulty"
                    android:textColor="@color/diff_easy"
                    android:textSize="15sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/symbol_arrow"
                    android:textColor="@color/text_muted"
                    android:textSize="18sp"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <!-- QUIZ TYPE -->
            <LinearLayout
                android:id="@+id/rowType"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_accent"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Quiz Type"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"/>
                <TextView
                    android:id="@+id/tvType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Text"
                    android:textColor="@color/accent_gold"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/symbol_arrow"
                    android:textColor="@color/text_muted"
                    android:textSize="18sp"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <!-- LANGUAGE -->
            <LinearLayout
                android:id="@+id/rowLanguage"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_accent"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_languages"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"/>
                <TextView
                    android:id="@+id/tvLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/default_languages"
                    android:textColor="@color/accent_gold"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/symbol_arrow"
                    android:textColor="@color/text_muted"
                    android:textSize="18sp"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <!-- COUNT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_accent"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_count"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"/>
                <TextView
                    android:id="@+id/btnMinus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="@string/symbol_minus"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_gold"
                    android:clickable="true"
                    android:focusable="true"/>
                <TextView
                    android:id="@+id/tvCount"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/default_count"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/btnPlus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="@string/symbol_plus"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_gold"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- CUSTOM TOPIC -->
            <EditText
                android:id="@+id/etCustomTopic"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input"
                android:hint="@string/hint_custom_topic"
                android:autofillHints=""
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:padding="14dp"
                android:gravity="top"
                android:inputType="textMultiLine"/>

            <!-- GENERATE BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGenerate"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="@string/btn_generate_ai"
                android:textColor="@color/bg_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/accent_gold"
                app:cornerRadius="14dp"/>

            <!-- PROGRESS -->
            <LinearLayout
                android:id="@+id/layoutProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="48dp"
                    android:layout_height="48dp"/>

                <TextView
                    android:id="@+id/tvProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_generating"
                    android:textColor="@color/accent_gold"
                    android:textSize="15sp"
                    android:layout_marginTop="16dp"/>

                <TextView
                    android:id="@+id/tvProgressDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_please_wait"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- ERROR -->
            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#33F44336"
                android:padding="14dp"
                android:layout_marginTop="16dp"
                android:textColor="@color/status_error"
                android:textSize="13sp"
                android:visibility="gone"/>

            <!-- RESULT -->
            <LinearLayout
                android:id="@+id/layoutResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/tvResultCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/result_count_default"
                    android:textColor="@color/status_success"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReview"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_review_edit"
                    android:textColor="@color/bg_primary"
                    android:textSize="15sp"
                    app:backgroundTint="@color/status_info"
                    app:cornerRadius="12dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUploadDirect"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_upload_directly"
                    android:textColor="@color/bg_primary"
                    android:textSize="15sp"
                    app:backgroundTint="@color/status_success"
                    app:cornerRadius="12dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>