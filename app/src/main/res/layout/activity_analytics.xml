<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="vertical"
    tools:ignore="UnusedNamespace">

    <include
        android:id="@+id/includeHeader"
        layout="@layout/include_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_analytics_title"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <!-- ═══ OVERVIEW CARDS ═══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_overview"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"/>

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_card"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="14dp"
                    android:layout_marginEnd="6dp">
                    <TextView android:text="@string/symbol_users_stat" android:textSize="22sp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/tvTotalUsers" android:text="@string/default_zero"
                        android:textColor="@color/accent_gold" android:textSize="20sp"
                        android:textStyle="bold" android:layout_marginTop="4dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="@string/label_total_users" android:textColor="@color/text_secondary"
                        android:textSize="11sp" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_card"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="14dp"
                    android:layout_marginHorizontal="6dp">
                    <TextView android:text="@string/symbol_questions_stat" android:textSize="22sp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/tvTotalQuestions" android:text="@string/default_zero"
                        android:textColor="@color/accent_gold" android:textSize="20sp"
                        android:textStyle="bold" android:layout_marginTop="4dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="@string/label_questions" android:textColor="@color/text_secondary"
                        android:textSize="11sp" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_card"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="14dp"
                    android:layout_marginStart="6dp">
                    <TextView android:text="@string/symbol_quizzes_stat" android:textSize="22sp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/tvTotalQuizzes" android:text="@string/default_zero"
                        android:textColor="@color/accent_gold" android:textSize="20sp"
                        android:textStyle="bold" android:layout_marginTop="4dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="@string/label_quizzes" android:textColor="@color/text_secondary"
                        android:textSize="11sp" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:baselineAligned="false">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_card"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="14dp"
                    android:layout_marginEnd="6dp">
                    <TextView android:text="@string/symbol_coins_stat" android:textSize="22sp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/tvTotalCoinsEarned" android:text="@string/default_zero"
                        android:textColor="@color/accent_gold" android:textSize="20sp"
                        android:textStyle="bold" android:layout_marginTop="4dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="@string/label_coins_earned" android:textColor="@color/text_secondary"
                        android:textSize="11sp" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_card"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="14dp"
                    android:layout_marginHorizontal="6dp">
                    <TextView android:text="@string/symbol_premium" android:textSize="22sp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/tvPremiumUsers" android:text="@string/default_zero"
                        android:textColor="@color/status_info" android:textSize="20sp"
                        android:textStyle="bold" android:layout_marginTop="4dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="@string/filter_premium" android:textColor="@color/text_secondary"
                        android:textSize="11sp" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_card"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="14dp"
                    android:layout_marginStart="6dp">
                    <TextView android:text="@string/symbol_pending_withdrawals" android:textSize="22sp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/tvPendingWithdrawals" android:text="@string/default_zero"
                        android:textColor="@color/status_warning" android:textSize="20sp"
                        android:textStyle="bold" android:layout_marginTop="4dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="@string/label_pending_stat" android:textColor="@color/text_secondary"
                        android:textSize="11sp" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ═══ QUESTIONS BY CATEGORY ═══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_questions_by_category"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:id="@+id/layoutCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_accent"
                android:orientation="vertical"
                android:padding="16dp"/>

            <!-- ═══ QUESTIONS BY DIFFICULTY ═══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_questions_by_difficulty"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:id="@+id/layoutDifficulty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_accent"
                android:orientation="vertical"
                android:padding="16dp"/>

            <!-- ═══ TOP PERFORMERS ═══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_top_performers"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:id="@+id/layoutTopUsers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_accent"
                android:orientation="vertical"
                android:padding="16dp"/>

            <!-- ═══ WITHDRAWAL SUMMARY ═══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_withdrawal_summary"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_accent"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingVertical="6dp"
                    android:baselineAligned="false">
                    <TextView android:text="@string/label_total_withdrawals" android:textColor="@color/text_muted"
                        android:textSize="14sp" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"/>
                    <TextView android:id="@+id/tvWithdrawalTotal" android:text="@string/default_zero"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:textStyle="bold" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#2A3A4E"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingVertical="6dp"
                    android:baselineAligned="false">
                    <TextView android:text="@string/label_approved_amount" android:textColor="@color/text_muted"
                        android:textSize="14sp" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"/>
                    <TextView android:id="@+id/tvWithdrawalApproved" android:text="@string/default_zero"
                        android:textColor="@color/status_success" android:textSize="14sp"
                        android:textStyle="bold" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#2A3A4E"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingVertical="6dp"
                    android:baselineAligned="false">
                    <TextView android:text="@string/label_pending_amount" android:textColor="@color/text_muted"
                        android:textSize="14sp" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"/>
                    <TextView android:id="@+id/tvWithdrawalPending" android:text="@string/default_zero"
                        android:textColor="@color/status_warning" android:textSize="14sp"
                        android:textStyle="bold" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ═══ RECENT ACTIVITY LOG ═══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_recent_actions"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:id="@+id/layoutLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_accent"
                android:orientation="vertical"
                android:padding="16dp"/>

            <!-- ═══ MAINTENANCE TOOLS ═══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAINTENANCE TOOLS"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCleanupLeaderboard"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_cleanup_leaderboard"
                android:textColor="@color/bg_primary"
                app:backgroundTint="@color/status_error"
                app:cornerRadius="12dp"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="32dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
