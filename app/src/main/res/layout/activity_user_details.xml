<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="vertical">

    <include
        android:id="@+id/includeHeader"
        layout="@layout/include_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="32dp">

            <!-- User Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAvatar"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:gravity="center"
                    android:text="@string/symbol_user"
                    android:textColor="@color/text_primary"
                    android:textSize="36sp"
                    android:background="@drawable/bg_card_accent"
                    android:importantForAccessibility="no"/>

                <TextView
                    android:id="@+id/tvUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"/>

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_active"
                    android:textColor="@color/status_success"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp"/>

                <TextView
                    android:id="@+id/tvPremium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_premium"
                    android:textColor="@color/status_info"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Stats Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:baselineAligned="false">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_card"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:layout_marginEnd="6dp">
                    <TextView android:id="@+id/tvTotalScore" android:text="@string/default_zero"
                        android:textColor="@color/accent_gold" android:textSize="20sp"
                        android:textStyle="bold" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView android:text="@string/label_score" android:textColor="@color/text_secondary"
                        android:textSize="11sp" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_card"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:layout_marginHorizontal="6dp">
                    <TextView android:id="@+id/tvTotalCoins" android:text="@string/default_zero"
                        android:textColor="@color/accent_gold" android:textSize="20sp"
                        android:textStyle="bold" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView android:text="@string/label_coins" android:textColor="@color/text_secondary"
                        android:textSize="11sp" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_card"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:layout_marginStart="6dp">
                    <TextView android:id="@+id/tvQuizzesPlayed" android:text="@string/default_zero"
                        android:textColor="@color/accent_gold" android:textSize="20sp"
                        android:textStyle="bold" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView android:text="@string/label_quizzes" android:textColor="@color/text_secondary"
                        android:textSize="11sp" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Wallet Balance -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_stat_card"
                android:gravity="center_vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Wallet Balance (PKR)"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvWalletBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rs. 0.00"
                    android:textColor="@color/status_success"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Performance -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:baselineAligned="false">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_card"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:layout_marginEnd="6dp">
                    <TextView android:id="@+id/tvCorrectAnswers" android:text="@string/default_zero"
                        android:textColor="@color/status_success" android:textSize="20sp"
                        android:textStyle="bold" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView android:text="@string/label_correct" android:textColor="@color/text_secondary"
                        android:textSize="11sp" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_card"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:layout_marginHorizontal="6dp">
                    <TextView android:id="@+id/tvAccuracy" android:text="@string/default_accuracy_zero"
                        android:textColor="@color/status_info" android:textSize="20sp"
                        android:textStyle="bold" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView android:text="@string/label_accuracy" android:textColor="@color/text_secondary"
                        android:textSize="11sp" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_card"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:layout_marginStart="6dp">
                    <TextView android:id="@+id/tvBestStreak" android:text="@string/default_zero"
                        android:textColor="@color/status_warning" android:textSize="20sp"
                        android:textStyle="bold" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView android:text="@string/label_best_streak" android:textColor="@color/text_secondary"
                        android:textSize="11sp" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Details -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/header_details"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_accent"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingVertical="4dp" android:baselineAligned="false">
                    <TextView android:text="@string/label_joined" android:textColor="@color/text_muted"
                        android:textSize="13sp" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"/>
                    <TextView android:id="@+id/tvJoined" android:text=""
                        android:textColor="@color/text_primary" android:textSize="13sp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingVertical="4dp" android:baselineAligned="false">
                    <TextView android:text="@string/label_last_active" android:textColor="@color/text_muted"
                        android:textSize="13sp" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"/>
                    <TextView android:id="@+id/tvLastActive" android:text=""
                        android:textColor="@color/text_primary" android:textSize="13sp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingVertical="4dp" android:baselineAligned="false">
                    <TextView android:text="@string/label_referral_code" android:textColor="@color/text_muted"
                        android:textSize="13sp" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"/>
                    <TextView android:id="@+id/tvReferralCode" android:text=""
                        android:textColor="@color/accent_gold" android:textSize="13sp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingVertical="4dp" android:baselineAligned="false">
                    <TextView android:text="@string/label_referrals" android:textColor="@color/text_muted"
                        android:textSize="13sp" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"/>
                    <TextView android:id="@+id/tvReferralCount" android:text="@string/default_zero"
                        android:textColor="@color/text_primary" android:textSize="13sp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Actions -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/header_actions"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"/>

            <!-- Add Coins -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_accent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">
                <EditText
                    android:id="@+id/etGiveCoins"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:hint="@string/hint_give_coins"
                    android:textColorHint="@color/text_muted"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:paddingHorizontal="12dp"
                    android:inputType="numberSigned"
                    android:autofillHints="none"
                    android:singleLine="true"
                    android:layout_marginEnd="8dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGiveCoins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/btn_give"
                    android:textColor="@color/bg_primary"
                    android:textSize="12sp"
                    app:backgroundTint="@color/accent_gold"
                    app:cornerRadius="10dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>
            </LinearLayout>

            <!-- Adjust Score and Wallet -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_accent"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <EditText
                        android:id="@+id/etAdjustScore"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:hint="Adjust Score (+/-)"
                        android:textColorHint="@color/text_muted"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:paddingHorizontal="12dp"
                        android:inputType="numberSigned"
                        android:layout_marginEnd="8dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAdjustScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SET"
                        android:textColor="@color/bg_primary"
                        android:textSize="12sp"
                        app:backgroundTint="@color/accent_gold"
                        app:cornerRadius="10dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <EditText
                        android:id="@+id/etAdjustWallet"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:hint="Adjust Wallet (+/-)"
                        android:textColorHint="@color/text_muted"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:paddingHorizontal="12dp"
                        android:inputType="numberDecimal|numberSigned"
                        android:layout_marginEnd="8dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAdjustWallet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SET"
                        android:textColor="@color/bg_primary"
                        android:textSize="12sp"
                        app:backgroundTint="@color/accent_gold"
                        app:cornerRadius="10dp"/>
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGiftLifelines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="10dp"
                android:text="@string/btn_gift_lifelines"
                android:textColor="@color/bg_primary"
                android:textSize="14sp"
                app:backgroundTint="@color/status_success"
                app:cornerRadius="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMakePremium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="10dp"
                android:text="@string/btn_make_premium"
                android:textColor="@color/bg_primary"
                android:textSize="14sp"
                app:backgroundTint="@color/status_info"
                app:cornerRadius="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/btn_ban_user"
                android:textColor="@color/status_error"
                android:textSize="14sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:cornerRadius="12dp"
                app:strokeColor="@color/status_error"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUnban"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/btn_unban_user"
                android:textColor="@color/status_success"
                android:textSize="14sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:cornerRadius="12dp"
                app:strokeColor="@color/status_success"
                android:visibility="gone"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/btn_delete_user_data"
                android:textColor="@color/status_error"
                android:textSize="13sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:cornerRadius="12dp"
                app:strokeColor="#440000"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
