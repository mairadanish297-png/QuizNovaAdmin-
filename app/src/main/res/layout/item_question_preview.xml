<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_accent"
    android:orientation="vertical"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <!-- Question Number + Difficulty + Delete -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/tvQuestionNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/default_q_number"
            android:textColor="@color/accent_gold"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvDifficulty"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:layout_marginStart="8dp"
            android:text="@string/label_easy_small"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_stat_card"
            tools:ignore="SmallSp"/>

        <TextView
            android:id="@+id/tvCategoryTag"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:layout_marginStart="6dp"
            android:text="@string/default_category"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:background="@drawable/bg_stat_card"
            tools:ignore="SmallSp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/btnDeleteQuestion"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="@string/label_x"
            android:textColor="@color/status_error"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- Question Text -->
    <TextView
        android:id="@+id/tvQuestionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sample_question"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.2"/>

    <!-- Options -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp">

        <!-- Option A -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
            <TextView
                android:id="@+id/tvOptionALetter"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:gravity="center"
                android:text="@string/option_a"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_stat_card"
                tools:ignore="SmallSp"/>
            <TextView
                android:id="@+id/tvOptionA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sample_option_a"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Option B -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
            <TextView
                android:id="@+id/tvOptionBLetter"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:gravity="center"
                android:text="@string/option_b"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_stat_card"
                tools:ignore="SmallSp"/>
            <TextView
                android:id="@+id/tvOptionB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sample_option_b"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Option C -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
            <TextView
                android:id="@+id/tvOptionCLetter"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:gravity="center"
                android:text="@string/option_c"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_stat_card"
                tools:ignore="SmallSp"/>
            <TextView
                android:id="@+id/tvOptionC"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sample_option_c"
                android:textColor="@color/status_success"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Option D -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tvOptionDLetter"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:gravity="center"
                android:text="@string/option_d"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_stat_card"
                tools:ignore="SmallSp"/>
            <TextView
                android:id="@+id/tvOptionD"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sample_option_d"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Explanation (collapsible) -->
    <TextView
        android:id="@+id/tvExplanation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sample_explanation"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:fontFamily="serif"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="30dp"
        android:lineSpacingMultiplier="1.2"
        android:visibility="gone"/>

    <!-- Toggle Explanation -->
    <TextView
        android:id="@+id/btnToggleExplanation"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:text="@string/btn_show_explanation"
        android:textColor="@color/accent_gold"
        android:textSize="11sp"
        android:paddingHorizontal="30dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"/>

</LinearLayout>
