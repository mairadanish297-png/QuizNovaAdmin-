<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_accent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:layout_marginBottom="8dp">

    <!-- Plan Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPlanLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="Plan Label"/>

        <TextView
            android:id="@+id/tvPlanDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:layout_marginTop="2dp"
            android:text="30 Days | type: 30days"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvPlanPriceCoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_gold"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="100 Coins"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  |  "
                android:textColor="@color/text_muted"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tvPlanPriceMoney"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/status_success"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="Rs. 399"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Buttons Column -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/btnEditPlan"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="EDIT"
            android:textColor="@color/accent_gold"
            android:textSize="10sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btnDeletePlan"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="DEL"
            android:textColor="#FFF44336"
            android:textSize="10sp"
            android:layout_marginTop="2dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

</LinearLayout>
