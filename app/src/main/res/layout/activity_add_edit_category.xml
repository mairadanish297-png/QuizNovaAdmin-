<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include
            android:id="@+id/includeHeader"
            layout="@layout/include_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_category_details"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <!-- Logo Preview -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_category_logo"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_accent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="20dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivLogoPreview"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_input"
                    android:src="@drawable/ic_category_placeholder"
                    app:shapeAppearanceOverlay="@style/RoundedCorners"/>

                <EditText
                    android:id="@+id/etImageUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:padding="14dp"
                    android:hint="Paste Image Direct Link (e.g., from ImgBB)"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:autofillHints="none"/>
            </LinearLayout>

            <!-- Category Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_category_name"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etCategoryName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:background="@drawable/bg_input"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:padding="14dp"
                android:hint="@string/hint_category_name"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:autofillHints="none"/>

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_description_optional"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="80dp"
                android:background="@drawable/bg_input"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:padding="14dp"
                android:hint="@string/hint_description"
                android:inputType="textMultiLine"
                android:gravity="top"
                android:maxLines="4"
                android:autofillHints="none"/>

            <!-- Color and Emoji -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_color_emoji"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etColor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:background="@drawable/bg_input"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:padding="14dp"
                    android:hint="@string/hint_hex_color"
                    android:inputType="text"
                    android:singleLine="true"
                    android:layout_marginEnd="8dp"
                    android:autofillHints="none"/>

                <EditText
                    android:id="@+id/etEmoji"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:background="@drawable/bg_input"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:padding="14dp"
                    android:hint="@string/hint_emoji"
                    android:gravity="center"
                    android:inputType="text"
                    android:singleLine="true"
                    android:autofillHints="none"/>
            </LinearLayout>

            <!-- Quiz Type -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUIZ TYPE"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>

            <RadioGroup
                android:id="@+id/rgQuizType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_input"
                android:padding="4dp">

                <RadioButton
                    android:id="@+id/rbText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Text"
                    android:textSize="11sp"
                    android:buttonTint="@color/accent_gold"
                    android:textColor="@color/text_primary"
                    android:checked="true"/>

                <RadioButton
                    android:id="@+id/rbImage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Image"
                    android:textSize="11sp"
                    android:buttonTint="@color/accent_gold"
                    android:textColor="@color/text_primary"/>

                <RadioButton
                    android:id="@+id/rbAudio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Audio"
                    android:textSize="11sp"
                    android:buttonTint="@color/accent_gold"
                    android:textColor="@color/text_primary"/>

                <RadioButton
                    android:id="@+id/rbVideo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Video"
                    android:textSize="11sp"
                    android:buttonTint="@color/accent_gold"
                    android:textColor="@color/text_primary"/>
            </RadioGroup>

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:text="@string/btn_save_category"
                android:textColor="@color/bg_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/accent_gold"
                app:cornerRadius="14dp"/>

            <!-- Progress -->
            <ProgressBar
                android:id="@+id/progressSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvSaveStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="13sp"
                android:layout_marginTop="8dp"
                android:visibility="gone"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>