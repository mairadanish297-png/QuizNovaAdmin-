<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="vertical"
    tools:context=".BulkUploadActivity">

    <include
        android:id="@+id/includeHeader"
        layout="@layout/include_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- Tab Selector -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/tabJson"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/tab_paste_json"
            android:textColor="@color/accent_gold"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_card_accent"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tabCsv"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/tab_csv_file"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:background="@drawable/bg_card_accent"
            android:layout_marginStart="6dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="32dp">

            <!-- JSON PASTE SECTION -->
            <LinearLayout
                android:id="@+id/layoutJsonSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_paste_json_array"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/msg_paste_json_array"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShowTemplate"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_show_json_template"
                    android:textColor="@color/accent_gold"
                    android:textSize="12sp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/bg_surface"
                    app:backgroundTint="@color/bg_surface"/>

                <EditText
                    android:id="@+id/etJsonInput"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input"
                    android:hint="@string/hint_paste_json_here"
                    android:textColorHint="@color/text_muted"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:padding="14dp"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:scrollbars="vertical"
                    android:importantForAutofill="no"
                    tools:targetApi="o"/>
            </LinearLayout>

            <!-- CSV SECTION -->
            <LinearLayout
                android:id="@+id/layoutCsvSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_upload_csv_file"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/msg_upload_csv_questions"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDownloadTemplate"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_download_csv_template"
                    android:textColor="@color/accent_gold"
                    android:textSize="12sp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/bg_surface"
                    app:backgroundTint="@color/bg_surface"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectCsv"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_select_csv_file"
                    android:textColor="@color/bg_primary"
                    android:textSize="15sp"
                    app:backgroundTint="@color/status_info"
                    app:cornerRadius="12dp"/>

                <TextView
                    android:id="@+id/tvCsvFileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/msg_no_file_selected"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp"/>

                <EditText
                    android:id="@+id/etCsvPreview"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:hint="@string/hint_csv_preview"
                    android:textColorHint="@color/text_muted"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:padding="14dp"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:importantForAutofill="no"
                    tools:targetApi="o"/>
            </LinearLayout>

            <!-- QUIZ TYPE SELECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUIZ TYPE"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>

            <RadioGroup
                android:id="@+id/rgQuizType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_input"
                android:padding="4dp">

                <RadioButton
                    android:id="@+id/rbText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Text"
                    android:textSize="11sp"
                    android:buttonTint="@color/accent_gold"
                    android:textColor="@color/text_primary"
                    android:checked="true"/>

                <RadioButton
                    android:id="@+id/rbImage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Image"
                    android:textSize="11sp"
                    android:buttonTint="@color/accent_gold"
                    android:textColor="@color/text_primary"/>

                <RadioButton
                    android:id="@+id/rbAudio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Audio"
                    android:textSize="11sp"
                    android:buttonTint="@color/accent_gold"
                    android:textColor="@color/text_primary"/>

                <RadioButton
                    android:id="@+id/rbVideo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Video"
                    android:textSize="11sp"
                    android:buttonTint="@color/accent_gold"
                    android:textColor="@color/text_primary"/>
            </RadioGroup>

            <!-- CATEGORY OVERRIDE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_category_override_caps"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_accent"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/msg_category_override_desc"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"/>

                <LinearLayout
                    android:id="@+id/rowCategory"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_default_category_text"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/tvCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_general_knowledge"
                        android:textColor="@color/accent_gold"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/symbol_arrow"
                        android:textColor="@color/text_muted"
                        android:textSize="18sp"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- VALIDATE -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnValidate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="@string/btn_validate_caps"
                android:textColor="@color/bg_primary"
                android:textSize="15sp"
                app:backgroundTint="@color/status_info"
                app:cornerRadius="12dp"/>

            <!-- Validation Result -->
            <LinearLayout
                android:id="@+id/layoutValidation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_accent"
                android:padding="14dp"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvValidationResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/tvValidationErrors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/status_error"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- PREVIEW SECTION -->
            <LinearLayout
                android:id="@+id/layoutPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_manage_all"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        tools:ignore="SelectableText"/>

                    <TextView
                        android:id="@+id/tvPreviewCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_review_count"
                        android:textColor="@color/accent_gold"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>

            <!-- UPLOAD -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpload"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="@string/btn_upload_to_firebase"
                android:textColor="@color/bg_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/status_success"
                app:cornerRadius="14dp"
                android:visibility="gone"/>

            <!-- PROGRESS -->
            <LinearLayout
                android:id="@+id/layoutProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"/>

                <TextView
                    android:id="@+id/tvProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_uploading_dots"
                    android:textColor="@color/accent_gold"
                    android:textSize="15sp"
                    android:layout_marginTop="12dp"/>

                <TextView
                    android:id="@+id/tvProgressDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 / 0"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"
                    tools:ignore="HardcodedText"/>
            </LinearLayout>

            <!-- RESULT -->
            <LinearLayout
                android:id="@+id/layoutResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_accent"
                android:padding="16dp"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvResultTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/title_complete"
                    android:textColor="@color/status_success"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvResultDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
