<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_accent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <!-- Book Cover -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivBookCover"
        android:layout_width="50dp"
        android:layout_height="65dp"
        android:scaleType="centerCrop"
        android:background="@drawable/ic_book_placeholder"
        android:src="@drawable/ic_book_placeholder"
        app:shapeAppearanceOverlay="@style/RoundedCorners"/>

    <!-- Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tvBookTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tvBookDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/tvBookChapters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent_gold"
            android:textSize="11sp"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Buttons Column -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/btnChapters"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="Chapters"
            android:textColor="@color/accent_gold"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_outline"
            android:paddingHorizontal="10dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btnEditBook"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="Edit"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:layout_marginTop="4dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btnDeleteBook"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="Delete"
            android:textColor="#FFF44336"
            android:textSize="10sp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

</LinearLayout>