<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/bg_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:baselineAligned="false">
            <TextView
                android:id="@+id/tvUsername"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_pending"
                android:textColor="@color/status_warning"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"/>
        </LinearLayout>

        <!-- Amount -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <TextView android:text="@string/label_amount" android:textColor="@color/text_muted"
                android:textSize="13sp" android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tvAmount"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/accent_gold" android:textSize="15sp"
                android:textStyle="bold"/>
            <TextView android:id="@+id/tvDollar"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_secondary" android:textSize="13sp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Method -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <TextView android:text="@string/label_method" android:textColor="@color/text_muted"
                android:textSize="13sp" android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tvMethod"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_primary" android:textSize="13sp"/>
        </LinearLayout>

        <!-- Account -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <TextView android:text="@string/label_account" android:textColor="@color/text_muted"
                android:textSize="13sp" android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tvAccount"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_primary" android:textSize="13sp"/>
        </LinearLayout>

        <!-- Date -->
        <TextView android:id="@+id/tvDate"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text_muted" android:textSize="11sp"
            android:layout_marginTop="6dp"/>

        <!-- Actions -->
        <LinearLayout
            android:id="@+id/layoutActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/btn_reject_caps"
                android:textColor="@color/status_error_light"
                android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:cornerRadius="10dp"
                app:strokeColor="@color/status_error_light"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApprove"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/btn_approve_caps"
                android:textColor="@color/bg_primary"
                android:textSize="12sp"
                app:backgroundTint="@color/status_success"
                app:cornerRadius="10dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
